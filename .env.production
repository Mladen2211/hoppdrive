# ─────────────────────────────────────────────────────────────
# HoppDrive – PRODUCTION Environment (.env.production)
# Copy this to .env on your production server
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-TO-STRONG-PASSWORD

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE-TO-RANDOM-64-CHAR-STRING
JWT_REFRESH_SECRET=CHANGE-TO-DIFFERENT-RANDOM-64-CHAR-STRING

# ─── CORS / Cookie ──────────────────────────────────────────
CORS_ORIGIN=https://hoppdrive.ch,https://admin.hoppdrive.ch
COOKIE_DOMAIN=.hoppdrive.ch

# ─── Public URLs (baked into Next.js at build time) ──────────
NEXT_PUBLIC_API_URL=https://api.hoppdrive.ch/api
NEXT_PUBLIC_ADMIN_URL=https://admin.hoppdrive.ch
NEXT_PUBLIC_SITE_URL=https://hoppdrive.ch

# ─── Brevo (Email) ──────────────────────────────────────────
BREVO_API_KEY=YOUR-BREVO-API-KEY
BREVO_SENDER_EMAIL=noreply@hoppdrive.ch
BREVO_SENDER_NAME=HoppDrive
ADMIN_NOTIFICATION_EMAIL=info@hoppdrive.ch

# ─── Mapbox ─────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=YOUR-MAPBOX-TOKEN

# ─── Google Analytics ────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ─── Google Search Console ───────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Upload ──────────────────────────────────────────────────
MAX_IMAGE_SIZE=5242880
