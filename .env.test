# ─────────────────────────────────────────────────────────────
# HoppDrive – TEST Environment (.env.test)
# Copy this to .env on your test server
# ─────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────
POSTGRES_PASSWORD=test-db-password-change-me

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=test-jwt-secret-at-least-32-characters-long-change-me
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters-long-change-me

# ─── CORS / Cookie ──────────────────────────────────────────
CORS_ORIGIN=https://hoppdrive.mraguz.me:99,https://hoppdrive-admin.mraguz.me:98
COOKIE_DOMAIN=.mraguz.me

# ─── Public URLs (baked into Next.js at build time) ──────────
NEXT_PUBLIC_API_URL=https://api-hoppdrive.mraguz.me:97/api
NEXT_PUBLIC_ADMIN_URL=https://hoppdrive-admin.mraguz.me:98
NEXT_PUBLIC_SITE_URL=https://hoppdrive.mraguz.me:99

# ─── Brevo (Email) ──────────────────────────────────────────
# Leave empty until you have a Brevo account
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@hoppdrive.ch
BREVO_SENDER_NAME=HoppDrive
ADMIN_NOTIFICATION_EMAIL=admin@hoppdrive.ch

# ─── Mapbox ─────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Google Analytics (leave empty for test) ─────────────────
NEXT_PUBLIC_GA4_ID=

# ─── Upload ──────────────────────────────────────────────────
MAX_IMAGE_SIZE=5242880
