generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Admin ─────────────────────────────────────────────────────

model Admin {
  id                String         @id @default(uuid())
  email             String         @unique
  name              String
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  phone             String?
  signatureData     String?        @map("signature_data") @db.Text
  passwordHash      String         @map("password_hash")
  mustResetPassword Boolean        @default(true) @map("must_reset_password")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@map("admins")
}

// ─── Vehicle ───────────────────────────────────────────────────

model Vehicle {
  id              String         @id @default(uuid())
  brand           String
  model           String
  type            VehicleType
  year            Int
  basePricePerDay Decimal        @map("base_price_per_day") @db.Decimal(10, 2)
  currency        String         @default("CHF")
  horsepower      Int
  transmission    Transmission
  seats           Int
  fuelType        FuelType       @map("fuel_type")
  range           String?
  isAvailable     Boolean        @default(true) @map("is_available")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  images          VehicleImage[]
  bookings        Booking[]

  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(uuid())
  vehicleId String  @map("vehicle_id")
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

enum VehicleType {
  sedan
  suv
  estate
  coupe
  convertible
  electric
  van
}

enum Transmission {
  automatic
  manual
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
}

// ─── Contact Request ───────────────────────────────────────────

model ContactRequest {
  id                 String               @id @default(uuid())
  fullName           String               @map("full_name")
  email              String
  phone              String
  vehicleOfInterest  String?              @map("vehicle_of_interest")
  message            String
  desiredStartDate   DateTime?            @map("desired_start_date")
  desiredEndDate     DateTime?            @map("desired_end_date")
  privacyConsent     Boolean              @map("privacy_consent")
  marketingConsent   Boolean              @default(false) @map("marketing_consent")
  status             ContactRequestStatus @default(pending)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("contact_requests")
}

enum ContactRequestStatus {
  pending
  reviewed
  responded
  converted
  archived
}

// ─── Booking ───────────────────────────────────────────────────

model Booking {
  id             String         @id @default(uuid())
  vehicleId      String         @map("vehicle_id")
  customerName   String         @map("customer_name")
  customerEmail  String?        @map("customer_email")
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  totalPrice     Decimal        @map("total_price") @db.Decimal(10, 2)
  currency       String         @default("CHF")
  status         BookingStatus  @default(reserved)
  notes          String?
  contractStatus ContractStatus @default(PENDING) @map("contract_status")
  signatureData  String?        @map("signature_data") @db.Text
  signedAt       DateTime?      @map("signed_at")
  signeeIp       String?        @map("signee_ip")
  locationId     String?        @map("location_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  location       Location?      @relation(fields: [locationId], references: [id])
  invoices       Invoice[]

  @@map("bookings")
}

enum BookingStatus {
  reserved
  active
  completed
  cancelled
}

enum ContractStatus {
  PENDING
  SIGNED
  VOIDED
}

// ─── Pricing Rules ─────────────────────────────────────────────

model PricingRule {
  id              String   @id @default(uuid())
  fromDay         Int      @map("from_day")
  toDay           Int?     @map("to_day")
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pricing_rules")
}

// ─── Audit Log (FADP Compliance) ───────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Site Settings (CMS key-value store) ───────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─── Location (Standorte) ──────────────────────────────────────

model Location {
  id        String    @id @default(uuid())
  name      String
  address   String
  zip       String
  city      String
  country   String    @default("CH")
  phone     String?
  email     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  bookings  Booking[]

  @@map("locations")
}

// ─── Notification ──────────────────────────────────────────────

model Notification {
  id        String             @id @default(uuid())
  adminId   String             @map("admin_id")
  type      NotificationType
  title     String
  body      String
  refId     String?            @map("ref_id")
  readAt    DateTime?          @map("read_at")
  createdAt DateTime           @default(now()) @map("created_at")
  admin     Admin              @relation(fields: [adminId], references: [id])

  @@index([adminId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_INQUIRY
  CONTRACT_EXPIRING
  BOOKING_CREATED
  GENERAL
}

// ─── Invoice ───────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  bookingId       String        @map("booking_id")
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerAddress String?       @map("customer_address")
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  issueDate       DateTime      @map("issue_date")
  dueDate         DateTime      @map("due_date")
  subtotal        Decimal       @map("subtotal") @db.Decimal(10, 2)
  vatRate         Decimal       @map("vat_rate") @db.Decimal(5, 2)
  vatAmount       Decimal       @map("vat_amount") @db.Decimal(10, 2)
  penalty         Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("CHF")
  status          InvoiceStatus @default(PENDING)
  parentInvoiceId String?       @map("parent_invoice_id")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  booking         Booking       @relation(fields: [bookingId], references: [id])
  parentInvoice   Invoice?      @relation("InvoiceReissue", fields: [parentInvoiceId], references: [id])
  reissues        Invoice[]     @relation("InvoiceReissue")

  @@index([bookingId])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
}
