# Database
DATABASE_URL="postgresql://hoppdrive:hoppdrive_password@localhost:5432/hoppdrive?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-very-long-random-string"
JWT_REFRESH_SECRET="change-this-to-another-very-long-random-string"

# ─── E-mail ───────────────────────────────────────────────────────────
# Transport: brevo | smtp | listmonk | log
# Default: brevo when BREVO_API_KEY is set, otherwise log (prints mails to the API console; development only).
EMAIL_PROVIDER=""
# Sender (falls back to BREVO_SENDER_EMAIL / BREVO_SENDER_NAME)
EMAIL_FROM=""
EMAIL_FROM_NAME=""

# Brevo
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@hoppdrive.ch"
BREVO_SENDER_NAME="HoppDrive"

# SMTP (EMAIL_PROVIDER=smtp): any mail server. SMTP_SECURE=true for implicit TLS (port 465).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Listmonk transactional API (EMAIL_PROVIDER=listmonk). One-time setup in Listmonk: create a transactional
# template with  Subject: {{ .Tx.Data.subject }}  and Body: {{ .Tx.Data.html | Safe }}  and copy its ID here.
LISTMONK_URL=""
LISTMONK_USER=""
LISTMONK_TOKEN=""
LISTMONK_TX_TEMPLATE_ID=""

# Public website (logo URL in e-mails, unsubscribe links). Falls back to NEXT_PUBLIC_SITE_URL, then https://hoppdrive.ch
PUBLIC_SITE_URL="http://localhost:99"
# Optional: absolute URL of the logo shown in e-mails (default: PUBLIC_SITE_URL/logos/logo-stacked.png)
EMAIL_LOGO_URL=""

# Admin Notification Email
ADMIN_NOTIFICATION_EMAIL="admin@hoppdrive.ch"

# Public base URL of the admin app. Used by the API for the links in invite and
# password-reset emails (falls back to NEXT_PUBLIC_ADMIN_URL, then http://localhost:98).
ADMIN_URL="http://localhost:98"

# Google Analytics (loaded only after consent)
NEXT_PUBLIC_GA4_ID=""

# Google Search Console verification (HTML tag method)
NEXT_PUBLIC_GSC_VERIFICATION=""

# App
NODE_ENV="development"
API_PORT=97
NEXT_PUBLIC_API_URL="http://localhost:97/api"
NEXT_PUBLIC_SITE_URL="http://localhost:99"
NEXT_PUBLIC_ADMIN_URL="http://localhost:98"

# Upload
UPLOAD_DIR="/uploads"
MAX_FILE_SIZE_MB=10

# Private storage for files with personal data (signed contracts, contract templates, damage photos,
# inspection reports, fine documents, e-mail attachments). NOT served by the web server, only through
# authenticated API routes. Docker: the `private` volume mounted at /app/private.
PRIVATE_UPLOAD_DIR="./private"
